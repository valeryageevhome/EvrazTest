                    <Properties>
                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>Message</Name>
                        </SerializationItem>
                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>Script</Name>
                            <Value xsi:type="xsd:string">string targetFolder = @"C:\RPA_Downloads"; // Путь из переменной
string prefPath = "";

string localAppData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
if(String.IsNullOrEmpty(Config["preferencesPath"].ToString().Trim()))
{
	prefPath = System.IO.Path.Combine(localAppData, @"Google\Chrome\User Data\Default\Preferences");
}
else
{
	prefPath = Config["preferencesPath"].ToString().Trim();
}

if (System.IO.File.Exists(prefPath))
{
    var json = Newtonsoft.Json.Linq.JObject.Parse(System.IO.File.ReadAllText(prefPath));
    
    if (json["download"] == null) json["download"] = new Newtonsoft.Json.Linq.JObject();
    json["download"]["default_directory"] = targetFolder;
    json["download"]["prompt_for_download"] = false;
    json["download"]["directory_upgrade"] = true;

    System.IO.File.WriteAllText(prefPath, json.ToString());
}</Value>
