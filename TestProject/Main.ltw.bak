                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Script</Name>
                                <Value xsi:type="xsd:string">// Путь до лога с системными ошибками
string logFilePath = Path
	.Combine(System.IO.Directory.GetCurrentDirectory(), Config["ExScreenshotsFolderPath"].ToString(), "СистемныйЛог.txt");

// Текст системного лога
string logText =
    $"{DateTime.Now.ToString("yyMMdd.hhmmss")} | Сообщение:\n" +
    $"{exception.Message}\n\n";

// Добавить текст в конец файла, учитывая кодировку
System.IO.File.AppendAllText(
    logFilePath,
    logText,
    new UTF8Encoding(false)
);</Value>
