                            <Name>Script</Name>
                            <Value xsi:type="xsd:string">string rawUserDataPath = Config["userDataPath"]?.ToString().Trim();
string rawPathExtension = Config["pathExtension"]?.ToString().Trim();

string rawbusinessExPath = Config["BusinessExPath"]?.ToString()?.Trim();
string rawsystemExPath = Config["SystemExPath"]?.ToString()?.Trim();

// 1. Метод валидации и создания директории
Action&lt;string, string, bool&gt; ensureDirectoryValid = (path, paramName, flagCreate) =&gt;
{
    try
    {
		// Проверяем корректность формата пути и раскрываем относительный путь в абсолютный
        string fullPath = String.Empty;
		if(flagCreate)
		{
			fullPath = Path.GetFullPath(Path.Combine(path, paramName));
		}
		else
		{
			fullPath = Path.GetFullPath(path);
		}
		
        // Проверяем, что путь указывает на корень или конкретную папку, а не содержит недопустимые имена
        if (string.IsNullOrWhiteSpace(Path.GetPathRoot(fullPath)))
        {
            throw new FormatException($"Путь '{path}' не содержит корневого диска или сетевого префикса.");
        }
		
		// Если директория не существует — создаем её
		if(!Directory.Exists(fullPath))
		{
			Directory.CreateDirectory(fullPath);
		}
    }
    catch (Exception ex)
    {
        throw new InvalidOperationException($"Некорректный или недоступный путь в параметре '{paramName}': '{path}'. Ошибка: {ex.Message}", ex);
    }
};

// 2. Выполняем проверку и создание
ensureDirectoryValid(rawUserDataPath, "UserData", true);
ensureDirectoryValid(rawPathExtension, nameof(rawPathExtension), false);

ensureDirectoryValid(rawbusinessExPath, nameof(rawbusinessExPath), false);
ensureDirectoryValid(rawsystemExPath, nameof(rawsystemExPath), false);

// 3. Присваиваем проверенные пути в рабочие переменные
userDataPath = Path.GetFullPath(Path.Combine(rawUserDataPath, "UserData"));
pathExtension = Path.GetFullPath(rawPathExtension);

businessExPath = Path.GetFullPath(rawbusinessExPath);
systemExPath = Path.GetFullPath(rawsystemExPath);</Value>
