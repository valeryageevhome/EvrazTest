                <SerializationComponent>
                    <ClassName>LTools.Workflow.Elements.Script.WFCSScript</ClassName>
                    <AssemblyName>LTools.Workflow, Version=1.0.6.1, Culture=neutral, PublicKeyToken=null</AssemblyName>
                    <Properties>
                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>Message</Name>
                        </SerializationItem>
                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>Script</Name>
                            <Value xsi:type="xsd:string">string filePath = resultExcelFile;

using (var workbook = new ClosedXML.Excel.XLWorkbook(filePath))
{
    var worksheet = workbook.Worksheet(1);

    var rangeUsed = worksheet.RangeUsed();

    if (rangeUsed != null)
    {
        int lastRow = rangeUsed.LastRow().RowNumber();
        int lastCol = rangeUsed.LastColumn().ColumnNumber();

        // 1. Форматирование столбцов по заголовкам
        for (int col = 1; col &lt;= lastCol; col++)
        {
            var headerCell = worksheet.Cell(1, col);
            string headerValue = headerCell.GetString().Trim();

            // Заголовок — текстовый формат (@)
            headerCell.Style.NumberFormat.Format = "@";

            if (lastRow &gt;= 2)
            {
                var dataRange = worksheet.Range(2, col, lastRow, col);

                if (headerValue.Equals("вес", System.StringComparison.OrdinalIgnoreCase))
                {
                    dataRange.Style.NumberFormat.Format = "0.00";
                }
                else
                {
                    dataRange.Style.NumberFormat.Format = "@";
                }
            }
        }

        // 2. Оформление всей таблицы (диапазон от A1 до lastRow/lastCol)
        var tableRange = worksheet.Range(1, 1, lastRow, lastCol);

        // Границы (тонкая сплошная линия)
        tableRange.Style.Border.InsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin;
        tableRange.Style.Border.OutsideBorder = ClosedXML.Excel.XLBorderStyleValues.Thin;

        // Выравнивание по правому краю
        tableRange.Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Right;

        // 3. Серый фон заголовков RGB(217, 217, 217)
        var headerRange = worksheet.Range(1, 1, 1, lastCol);
        headerRange.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromArgb(217, 217, 217);

        // 4. Столбец A со 2-й строки — жирный шрифт
        if (lastRow &gt; 1)
        {
            worksheet.Range(2, 1, lastRow, 1).Style.Font.Bold = true;
        }

        // 5. Автоподбор ширины столбцов
        worksheet.Columns(1, lastCol).AdjustToContents();
    }

    workbook.Save();
}</Value>
