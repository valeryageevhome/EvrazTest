                                        <SerializationItem>
                                            <IsListValue>false</IsListValue>
                                            <Name>Script</Name>
                                            <Value xsi:type="xsd:string">string folderPath = downloadPath;   // путь к каталогу
string fileNameWithoutExt = nameFile; // имя файла без расширения

// Выходная переменная:
fileExtension = string.Empty;

if (!Directory.Exists(folderPath))
{
    throw new DirectoryNotFoundException($"Каталог не найден: {folderPath}");
}

// 1. Ищем файлы, начинающиеся с имени и точки
// Поиск по маске "name.*" исключит совпадения вроде "name_backup.txt"
string searchPattern = $"{fileNameWithoutExt}.*";

// 2. Находим первый подходящий файл с точным совпадением имени без расширения
string matchedFile = Directory.EnumerateFiles(folderPath, searchPattern, SearchOption.TopDirectoryOnly)
    .FirstOrDefault(filePath =&gt; 
        string.Equals(
            Path.GetFileNameWithoutExtension(filePath), 
            fileNameWithoutExt, 
            StringComparison.OrdinalIgnoreCase
        )
    );

// 3. Получаем расширение
if (!string.IsNullOrEmpty(matchedFile))
{
    // Path.GetExtension вернет значение с точкой, например: ".xlsx" или ".pdf"
    fileExtension = Path.GetExtension(matchedFile);
}

</Value>
