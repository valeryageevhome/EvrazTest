                        <SerializationComponent>
                            <ClassName>LTools.Workflow.Elements.Script.WFCSScript</ClassName>
                            <AssemblyName>LTools.Workflow, Version=1.0.6.1, Culture=neutral, PublicKeyToken=null</AssemblyName>
                            <Properties>
                                <SerializationItem>
                                    <IsListValue>false</IsListValue>
                                    <Name>Message</Name>
                                </SerializationItem>
                                <SerializationItem>
                                    <IsListValue>false</IsListValue>
                                    <Name>Script</Name>
                                    <Value xsi:type="xsd:string">// 1. Папка Default внутри кастомного профиля робота
string profileDefaultDir = Path.Combine(userDataPath, "Default");
string prefsPath = Path.Combine(profileDefaultDir, "Preferences");

// Если профиль совсем новый, создаем папку Default, чтобы было куда положить Preferences
if (!Directory.Exists(profileDefaultDir))
{
    Directory.CreateDirectory(profileDefaultDir);
}

// 2. Считываем JSON файла изолированного профиля (если есть) или берем пустой
string json = File.Exists(prefsPath) ? File.ReadAllText(prefsPath) : "{}";
JObject prefs = JObject.Parse(json);

// 3. Гарантируем наличие секции "download"
if (prefs["download"] == null)
{
    prefs["download"] = new JObject();
}

// 4. Включаем показ диалогового окна "Сохранить как..." ТОЛЬКО для этого профиля
prefs["download"]["prompt_for_download"] = true;

// 5. Сохраняем изменения обратно в файл профиля робота
File.WriteAllText(prefsPath, prefs.ToString());</Value>
                                </SerializationItem>
                                <SerializationItem>
                                    <IsListValue>false</IsListValue>
                                    <Name>Result</Name>
                                </SerializationItem>
                                <SerializationItem>
