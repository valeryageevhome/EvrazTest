                            </SerializationItem>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Script</Name>
                                <Value xsi:type="xsd:string">(function() {
    // Рекурсивный поиск элемента по селектору сквозь любые уровни Shadow Root
    function queryShadow(selector, root = document) {
        let el = root.querySelector(selector);
        if (el) return el;
        const treeWalker = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT, null, false);
        while (treeWalker.nextNode()) {
            const node = treeWalker.currentNode;
            if (node.shadowRoot) {
                const found = queryShadow(selector, node.shadowRoot);
                if (found) return found;
            }
        }
        return null;
    }

    // Ищем тумблер настройки "Перед скачиванием спрашивать, куда сохранить файл"
    // В Chrome Settings элемент имеет атрибут pref="download.prompt_for_download"
    const toggle = queryShadow('settings-toggle-button[pref*="prompt_for_download"], cr-toggle#control');
    
    if (toggle) {
        // Проверяем текущее состояние: если выключен — кликаем
        const isChecked = toggle.checked || toggle.getAttribute('aria-checked') === 'true' || toggle.hasAttribute('checked');
        if (!isChecked) {
            toggle.click();
        }
        return true;
    }
    return false;
})</Value>
