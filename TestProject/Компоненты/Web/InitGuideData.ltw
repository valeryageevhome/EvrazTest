                    <SerializationComponent>
                        <ClassName>LTools.Workflow.Elements.Script.WFCSScript</ClassName>
                        <AssemblyName>LTools.Workflow, Version=1.0.6.1, Culture=neutral, PublicKeyToken=null</AssemblyName>
                        <Properties>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Message</Name>
                            </SerializationItem>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Script</Name>
                                <Value xsi:type="xsd:string">// 1. Находим исходные названия колонок (листов), подходящих под критерии
sheetMark = sheets.FirstOrDefault(sh =&gt; 
    Regex.Replace((sh ?? "").ToLower(), @"\s+", "") == "марка");

sheetMine = sheets.FirstOrDefault(sh =&gt; 
    Regex.Replace((sh ?? "").ToLower(), @"\s+", "") == "шахты");

// 2. Выделяем в массив найденные исходные названия
matchedSheets = new List&lt;string&gt;(){ sheetMark, sheetMine };

// 3. Флаг проверки: обе колонки должны быть найдены
flagSheets = sheetMark != null &amp;&amp; sheetMine != null;</Value>
                            </SerializationItem>
                            <SerializationItem>
                                <IsListValue>false</IsListValue>
                                <Name>Result</Name>
                            </SerializationItem>
                            <SerializationItem>
