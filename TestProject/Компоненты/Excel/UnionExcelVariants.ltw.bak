                            <Name>Script</Name>
                            <Value xsi:type="xsd:string">if (mineResult != null &amp;&amp; mineResult.Rows.Count &gt; 0)
{
    // Если схема dtSummary еще пустая, копируем структуру первого результата
    if (dtSummary.Columns.Count == 0)
    {
        dtSummary = mineResult.Clone();
    }
    
    // Объединяем данные текущей шахты в общую таблицу
    dtSummary.Merge(mineResult);
}</Value>
