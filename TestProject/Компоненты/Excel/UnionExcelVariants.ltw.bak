                            <Value xsi:type="xsd:string">colMarkName = tempTable.Columns.Cast&lt;DataColumn&gt;()
    .FirstOrDefault(c =&gt; c.ColumnName.Trim().Replace(" ", "").Equals("Марка", StringComparison.OrdinalIgnoreCase))?.ColumnName;

colWeightName = tempTable.Columns.Cast&lt;DataColumn&gt;()
