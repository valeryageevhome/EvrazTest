            <IsIgnore>false</IsIgnore>
            <Components>
                <SerializationComponent>
                    <ClassName>LTools.Workflow.Elements.Script.WFCSScript</ClassName>
                    <AssemblyName>LTools.Workflow, Version=1.0.6.1, Culture=neutral, PublicKeyToken=null</AssemblyName>
                    <Properties>
                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>Message</Name>
                        </SerializationItem>
                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>Script</Name>
                            <Value xsi:type="xsd:string">// 1. Инициализируем результирующую таблицу с нужной структурой
DataTable mineResult = new DataTable();
mineResult.Columns.Add("Шахта", typeof(string));
mineResult.Columns.Add("Марка", typeof(string));
mineResult.Columns.Add("Вес", typeof(double));

List&lt;string&gt; marks = guideMark
.Where(m =&gt; !string.IsNullOrWhiteSpace(m))
.Select(m =&gt; m.Trim().ToLowerInvariant())
.Distinct()
.ToList();

// 2. Выполняем группировку и фильтрацию
var groupedRows = tempTable.AsEnumerable()
    .Where(r =&gt; 
        !r.IsNull(colMarkName) &amp;&amp; 
        !r.IsNull(colWeightName) &amp;&amp; 
        marks.Contains(r[colMarkName].ToString().Trim().ToLowerInvariant())
    )
    .GroupBy(r =&gt; r[colMarkName].ToString().Trim(), StringComparer.OrdinalIgnoreCase)
    .OrderBy(g =&gt; g.Key, StringComparer.OrdinalIgnoreCase)
    .Select(g =&gt; 
    {
        var row = mineResult.NewRow();
        row["Шахта"] = mine;
        row["Марка"] = g.Key;
        
        // Парсинг веса с защитой от точек/запятых в дробной части
        double totalWeight = g.Sum(r =&gt; 
        {
            string val = r[colWeightName].ToString().Trim().Replace(',', '.');
            return double.TryParse(val, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double parsedVal) 
                ? parsedVal 
                : 0.0;
        });
        
        row["Вес"] = Math.Round(totalWeight, 2);
        return row;
    })
    .ToList();

// 3. Добавляем строки и мерджим (без риска падения на пустом наборе данных)
if (groupedRows.Count &gt; 0)
{
    foreach (var row in groupedRows)
    {
        mineResult.Rows.Add(row);
    }

    if (dtSummary.Columns.Count == 0)
    {
        dtSummary = mineResult.Clone();
    }

    dtSummary.Merge(mineResult);
}

</Value>
