                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>Script</Name>
                            <Value xsi:type="xsd:string">// 1. Очищаем целевое имя шахты (убираем пробелы, ё-&gt;е, в нижний регистр)
string cleanTargetName = Regex.Replace((mine ?? "").ToLower().Replace("ё", "е"), @"\s+", "");

// 2. Ищем файл отчета, вырезая пробелы, ё-&gt;е и суффикс "_отчет" через regex
reportPath = Directory.GetFiles(matchedFolder, "*.xlsx")
    .FirstOrDefault(f =&gt; Regex.Replace(Path.GetFileNameWithoutExtension(f).ToLower().Replace("ё", "е"), @"\s+|_отчет$", "") == cleanTargetName);</Value>
