                    <Properties>
                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>Message</Name>
                        </SerializationItem>
                        <SerializationItem>
                            <IsListValue>false</IsListValue>
                            <Name>Script</Name>
                            <Value xsi:type="xsd:string">sqlQuery = $@"SELECT 
    ? AS [Шахта], 
    TRIM([Марка]) AS [Марка], 
    CDbl(ROUND(SUM(CDbl([Вес])), 2)) AS [Вес]
FROM [{sheetName.Replace("'", "''")}$]
WHERE LCASE(TRIM([Марка])) IN ({marks})
  AND [Вес] IS NOT NULL
GROUP BY TRIM([Марка])
ORDER BY TRIM([Марка])";</Value>
                        </SerializationItem>
