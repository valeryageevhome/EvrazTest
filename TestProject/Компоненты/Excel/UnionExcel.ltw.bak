                                    <Name>Script</Name>
                                    <Value xsi:type="xsd:string">// Папка, которая соответствует шахте со справочника
matchedFolder = Directory
	.GetDirectories(mainFolder)
	.FirstOrDefault(dir =&gt; Path.GetFileName(dir).Replace(" ", "").Replace("ё", "е").Trim()
	.Equals(mine.Replace(" ", "").Replace("ё", "е").Trim(), StringComparison.OrdinalIgnoreCase));</Value>
