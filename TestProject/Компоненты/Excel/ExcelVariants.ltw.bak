                            <Name>Script</Name>
                            <Value xsi:type="xsd:string">// Нормализация имен колонок (для универсальности)
// Исключение случаев регистра, ошибочного написания, которое не выходит за допустимый смысл
string nameMine = "шахта";
columnMineName = tempTable
	.Columns
	.Cast&lt;DataColumn&gt;()
	.FirstOrDefault(c =&gt; (c.ColumnName ?? "")
        .Replace(" ", "")
        .Replace("ё", "е")
		.Trim()
        .IndexOf(nameMine, StringComparison.OrdinalIgnoreCase) &gt;= 0)
    ?.ColumnName;

// Аналогично
string nameInn = "инн";
columnInnName = tempTable
	.Columns
	.Cast&lt;DataColumn&gt;()
    .FirstOrDefault(c =&gt; (c.ColumnName ?? "")
        .Replace(" ", "")
        .Replace("ё", "е")
        .IndexOf(nameInn, StringComparison.OrdinalIgnoreCase) &gt;= 0)
    ?.ColumnName;</Value>
